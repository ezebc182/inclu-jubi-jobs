// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Sin valor hasta que la persona elige en /onboarding.
  ///
  /// Antes era `@default(CANDIDATE)`, y eso volvia imposible registrarse como
  /// empresa: quien entraba con Google quedaba marcado como candidato sin que
  /// se le preguntara, y /onboarding —que ve el rol ya puesto— lo mandaba
  /// directo a /empleos sin mostrar nunca el selector.
  role      UserRole?
  email     String   @unique
  emailVerified Boolean @default(false)
  name      String?
  image     String?

  // Portal por el que se registró. Un candidato solo ve contenido de su portal.
  portal    Portal   @default(JUBI)

  // Moderación desde /admin
  isActive        Boolean   @default(true)
  suspendedAt     DateTime?
  suspendedReason String?

  // Perfil candidato
  isDisabled         Boolean         @default(false)
  disabilityType     DisabilityType?
  accessibilityNeeds String?
  phoneNumber        String?
  phoneNumberVerified Boolean?
  whatsappNumber     String? // Número de WhatsApp (puede ser distinto al teléfono)
  location           String? // Ciudad/Provincia (ej: "CABA", "Córdoba")
  birthYear          Int? // Para validar 60+/65+

  // 3 preguntas
  did      String? // ¿Qué hiciste?
  canDo    String? // ¿Qué sabés hacer?
  wantToDo String? // ¿Qué te gustaría hacer?

  company      Company?
  applications Application[]
  sessions     Session[]
  accounts     Account[]
  savedSearches SavedSearch[]

  @@index([email])
  @@index([role])
  @@index([portal, role])
  @@index([createdAt(sort: Desc)])
}

model SavedSearch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   // Nombre descriptivo de la búsqueda

  // Portal en el que se guardó la búsqueda
  portal    Portal   @default(JUBI)

  // Filtros guardados
  province  String?
  modality  Modality?
  schedule  Schedule?

  @@index([userId])
  @@index([userId, portal])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Cuenta de un proveedor de identidad vinculada a un usuario.
///
/// Los nombres de los campos los define Better-Auth, no nosotros: su adaptador
/// de Prisma escribe exactamente estas columnas. Si falta una, el insert entero
/// se rechaza y el login termina en `unable_to_create_user` — que es lo que
/// pasaba con `scope`, `accessTokenExpiresAt` y `refreshTokenExpiresAt`.
///
/// `expiresAt` era el nombre de la versión anterior; 1.4 lo separó en dos
/// campos, uno por token. Se mantiene la columna vieja para no romper filas
/// existentes, pero ya no la usa nadie.
model Account {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String
  providerId      String
  accessToken     String?
  refreshToken    String?
  idToken         String?
  /// Permisos que otorgó la persona en la pantalla de Google.
  scope           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  /// Obsoleto: reemplazado por los dos campos de arriba. No se escribe más.
  expiresAt       DateTime?
  password        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model Company {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ownerId    String   @unique
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  logoUrl    String?
  website    String?
  about      String?
  location   String? // Provincia/Ciudad
  whatsappNumber String? // Número de WhatsApp de contacto
  isVerified Boolean  @default(false)

  // ─── Acreditación de quien publica ──────────────────────────────
  //
  // Antes el único dato obligatorio era el nombre: cualquiera escribía
  // "Empresa SA" y ya podía publicar avisos que ven personas jubiladas y
  // personas con discapacidad buscando trabajo.
  //
  // Nada de esto PRUEBA identidad —no se consulta a AFIP ni a RENAPER—, pero
  // deja rastro y disuade: quien inventa un CUIT miente por escrito. La defensa
  // real sigue siendo la moderación; estos datos son para que quien modera
  // tenga con qué decidir, en vez de mirar un nombre suelto.

  /// EMPRESA o PARTICULAR. Mucho trabajo por día para esta audiencia lo ofrece
  /// una casa que busca cuidador, no una empresa formal: dejarlos afuera sería
  /// dejar afuera el trabajo real.
  employerType EmployerType @default(EMPRESA)

  /// CUIT de la empresa. Se valida el dígito verificador, no la titularidad.
  taxId      String?
  /// DNI de quien publica, cuando es particular.
  nationalId String?

  /// Quién publica y con qué responsabilidad. Un aviso lo firma una persona,
  /// no una razón social.
  contactName  String?
  contactRole  String?
  contactPhone String?

  // Empresa verificada: sus avisos se auto-aprueban y saltan la cola de moderación.
  autoApproveJobs Boolean @default(false)

  // Moderación desde /admin
  isActive        Boolean   @default(true)
  suspendedAt     DateTime?
  suspendedReason String?

  jobs Job[]

  @@index([ownerId])
  @@index([isVerified])
  @@index([taxId])
  @@index([createdAt(sort: Desc)])
}

model Job {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title        String
  description  String
  province     String // Normalizado a provincias AR
  city         String?
  schedule     Schedule // PART_TIME, FLEX, POR_DIA
  modality     Modality // PRESENCIAL, HIBRIDO, REMOTO
  salaryArsMin Int?
  salaryArsMax Int?
  status       JobStatus @default(DRAFT)
  tags         String[] // p. ej. ["Atención al cliente","Administración"]

  // Portales donde se publica el aviso. La empresa elige uno, otro o ambos.
  // Se filtra con `portals: { has: <portal> }` en toda query pública.
  portals Portal[] @default([JUBI])

  // Accesibilidad declarada del puesto. Clave para IncluJobs: el candidato
  // necesita saber ANTES de postularse si el lugar está preparado.
  accessibilityNotes String?
  isRemoteFriendly   Boolean @default(false)
  hasAccessibleSite  Boolean @default(false) // rampa, ascensor, baño adaptado
  supportsFlexHours  Boolean @default(false)

  // Moderación desde /admin
  moderationStatus ModerationStatus @default(PENDING)
  moderatedAt      DateTime?
  moderatedById    String?
  moderationNote   String?

  applicants Application[]

  @@index([status, province, modality, schedule])
  @@index([companyId])
  @@index([moderationStatus, createdAt(sort: Desc)])
  @@index([portals])
  @@index([createdAt(sort: Desc)])
}

model Application {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  jobId     String
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Respuestas guardadas por si el usuario las ajusta distinto a su perfil
  did      String
  canDo    String
  wantToDo String

  status AppStatus @default(SUBMITTED) // SUBMITTED, REVIEWED, CONTACTED, REJECTED
  notes  String?

  @@unique([jobId, userId]) // Una postulación por usuario por empleo
  @@index([jobId, createdAt(sort: Desc)])
  @@index([userId])
}

/// Persona que dejó su correo sin registrarse.
///
/// Tabla SEPARADA de User a propósito. Un lead no tiene rol, ni sesión, ni
/// cuenta OAuth, ni portal de registro —solo dijo "avisame"—. Y el `email
/// @unique` de User choca de frente el día que esa misma persona se registra
/// en serio: tendríamos que elegir entre perder el lead o romper el alta.
///
/// La única compuesta es intencional: la misma persona puede anotarse como
/// candidato en JubiJobs y como empresa en IncluJobs, y son dos intenciones
/// distintas. Reenviar el formulario hace upsert, no duplica.
model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  email  String
  portal Portal
  kind   LeadKind

  /// Provincia AR, si la dejó. Opcional: cada campo obligatorio es gente que
  /// abandona el formulario, y el correo solo ya sirve para avisar.
  province String?

  /// "También me sirve trabajo remoto". NO es lo mismo que `province`: un
  /// aviso remoto igual tiene provincia, y alguien de Chaco puede querer lo
  /// de Chaco Y lo remoto. Son dos dimensiones, no una sola.
  wantsRemote Boolean @default(false)

  /// Cuándo se le avisó por última vez. `null` = nunca. Es el corte que usa
  /// /admin/lista para no mandarle dos veces la misma noticia.
  notifiedAt DateTime?

  @@unique([email, portal, kind])
  /// El índice calca la query del admin: "los que faltan avisar de este
  /// portal y este tipo". Sin él, cada envío escanea la tabla entera.
  @@index([portal, kind, notifiedAt])
  @@index([createdAt(sort: Desc)])
}

/// Qué vino a buscar quien dejó el correo. Determina qué mail recibe: al
/// candidato se le cuentan avisos, a la empresa se le cuentan candidatos.
enum LeadKind {
  CANDIDATE
  COMPANY
}

/// Traza de acciones administrativas. Sin esto, "gestionar los portales" es
/// un botón que borra cosas sin que nadie sepa quién ni por qué.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String // User.id del admin que ejecutó la acción
  action     String // "job.approve", "company.suspend", "user.role_change", ...
  targetType String // "Job" | "Company" | "User"
  targetId   String
  portal     Portal?
  metadata   Json? // payload libre: valores previos, motivo, etc.

  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([createdAt(sort: Desc)])
}

/// Portales del producto. Son audiencias SEPARADAS, no intercambiables:
/// un candidato de JUBI nunca ve contenido de INCLU y viceversa.
/// El valor se resuelve por dominio en el middleware (ver lib/portal.ts).
enum Portal {
  JUBI // jubijobs.com  — personas jubiladas / 60+
  INCLU // inclujobs.com — personas con discapacidad
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Quién publica un empleo.
enum EmployerType {
  EMPRESA
  PARTICULAR
}

enum UserRole {
  CANDIDATE
  COMPANY
  ADMIN
}

enum DisabilityType {
  NONE
  MOTRIZ
  VISUAL
  AUDITIVA
  COGNITIVA
  OTRA
}

enum Schedule {
  PART_TIME
  FLEX
  POR_DIA
}

enum Modality {
  PRESENCIAL
  HIBRIDO
  REMOTO
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
}

enum AppStatus {
  SUBMITTED
  REVIEWED
  CONTACTED
  REJECTED
}
