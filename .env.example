# Base de datos
DATABASE_URL="postgresql://user:password@localhost:5432/jubijobs"

# Better Auth
AUTH_SECRET="your-secret-key-min-32-chars-long"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth Providers (opcional)
BETTER_AUTH_GOOGLE_ID=""
BETTER_AUTH_GOOGLE_SECRET=""

BETTER_AUTH_MICROSOFT_ID=""
BETTER_AUTH_MICROSOFT_SECRET=""

BETTER_AUTH_FACEBOOK_ID=""
BETTER_AUTH_FACEBOOK_SECRET=""

# GitHub (deshabilitado en la app, pero configurado en Better Auth)
BETTER_AUTH_GITHUB_ID=""
BETTER_AUTH_GITHUB_SECRET=""

# SMS / OTP (opcional - para producción)
# En desarrollo, el código OTP es siempre "123456"
# En producción, configurar un servicio de SMS como Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Ambiente
NODE_ENV="development"
